ion": "Number of results to return per page.", "required": false, "type": "integer"}, {"name": "type", "in": "query", "description": "Contact type (e.g. email)", "type": "string"}, {"name": "detail", "in": "query", "description": "Contact detail (e.g dderpiston@gmail.com)", "type": "string"}, {"name": "email", "in": "query", "description": "Short cut for searching by email", "type": "string"}, {"name": "name", "in": "query", "description": "Search by name (full name for primary contact records)", "type": "string"}, {"name": "application_key", "in": "query", "description": "Search by application key", "type": "string"}], "responses": {"200": {"description": "", "schema": {"required": ["count", "results"], "type": "object", "properties": {"count": {"type": "integer"}, "next": {"type": "string", "format": "uri", "x-nullable": true}, "previous": {"type": "string", "format": "uri", "x-nullable": true}, "results": {"type": "array", "items": {"$ref": "#/definitions/Contact"}}}}}}, "tags": ["api"]}, "post": {"operationId": "api_contacts_create", "description": "ViewSet for contact objects", "parameters": [{"name": "data", "in": "body", "required": true, "schema": {"$ref": "#/definitions/Contact"}}], "responses": {"201": {"description": "", "schema": {"$ref": "#/definitions/Contact"}}}, "tags": ["api"]}, "parameters": []}, "/api/contacts/{ifxcon}/": {"get": {"operationId": "api_contacts_read", "description": "ViewSet for contact objects", "parameters": [], "responses": {"200": {"description": "", "schema": {"$ref": "#/definitions/Contact"}}}, "tags": ["api"]}, "put": {"operationId": "api_contacts_update", "description": "ViewSet for contact objects", "parameters": [{"name": "data", "in": "body", "required": true, "schema": {"$ref": "#/definitions/Contact"}}], "responses": {"200": {"description": "", "schema": {"$ref": "#/definitions/Contact"}}}, "tags": ["api"]}, "patch": {"operationId": "api_contacts_partial_update", "description": "ViewSet for contact objects", "parameters": [{"name": "data", "in": "body", "required": true, "schema": {"$ref": "#/definitions/Contact"}}], "responses": {"200": {"description": "", "schema": {"$ref": "#/definitions/Contact"}}}, "tags": ["api"]}, "delete": {"operationId": "api_contacts_delete", "description": "ViewSet for contact objects", "parameters": [], "responses": {"204": {"description": ""}}, "tags": ["api"]}, "parameters": [{"name": "ifxcon", "in": "path", "required": true, "type": "string"}]}, "/api/get-approver-contacts/": {"get": {"operationId": "api_get-approver-contacts_list", "description": "Given one or more organization slugs, return a list of possible approvers and their email addresses.\nIf role_filters are provided, only return approvers with those roles, otherwise PI and Lab Manager are used.\nOnly active contacts are returned.", "parameters": [{"name": "org_slugs", "in": "query", "type": "string"}, {"name": "role_filters", "in": "query", "type": "string"}], "responses": {"200": {"description": "", "schema": {"type": "array", "items": {"$ref": "#/definitions/GetApproverContacts"}}}, "400": {"description": "Bad Request"}, "404": {"description": "Not Found"}, "500": {"description": "Internal Server Error"}}, "tags": ["api"]}, "parameters": []}, "/api/get-basics-by-login/": {"get": {"operationId": "api_get-basics-by-login_list", "description": "Retrieve basic information by login.  Used in p3 OfficeHoursSignIn.\nInformation will be returned even if they don't have a department or a PI.", "parameters": [{"name": "login", "in": "query", "type": "string"}], "responses": {"200": {"description": "", "schema": {"type": "array", "items": {"$ref": "#/definitions/GetBasicsByLogin"}}}, "401": {"description": "Not authorized"}}, "tags": ["api"]}, "parameters": []}, "/api/get-location-info/": {"get": {"operationId": "api_get-location-info_list", "description": "Get location info for addresses.\nThe \"target\" parameter determines the field returned (country, state, city, postal_code)\nThe values for the target can be filtered by other fields.  For example, setting\ntarget to city and filtering by state will get you all of the cities in a particular state\n\nA \"location_info\" object is returned. If target was \"state\" and country was \"United States\".\n{\n    \"location_info\": [\n        \"Alabama\",\n        \"Arkansas\",\n        ...\n    ]\n}\n\nWhen \"United States\" is in the results (ie a \"country\" target), it is placed at the top of the list.", "parameters": [{"name": "target", "in": "query", "type": "string"}, {"name": "country", "in": "query", "type": "string"}, {"name": "state", "in": "query", "type": "string"}, {"name": "city", "in": "query", "type": "string"}, {"name": "postal_code", "in": "query", "type": "string"}], "responses": {"200": {"description": "", "schema": {"$ref": "#/definitions/GetLocationInfo"}}, "400": {"description": "Bad Request"}, "500": {"description": "Internal Server Error"}}, "tags": ["api"]}, "parameters": []}, "/api/get-org-list/": {"get": {"operationId": "api_get-org-list_list", "description": "Return list of names and member counts for organizations.\nMay be filtered by ifxid and role", "parameters": [{"name": "member", "in": "query", "type": "string"}, {"name": "member_role", "in": "query", "type": "string"}, {"name": "org_tree", "in": "query", "type": "string"}], "responses": {"200": {"description": "", "schema": {"type": "array", "items": {"$ref": "#/definitions/GetOrgList"}}}, "500": {"description": "Internal Server Error"}}, "tags": ["api"]}, "parameters": []}, "/api/get-org-names/": {"get": {"operationId": "api_get-org-names_list", "description": "Return org names for autocomplete list.  Department names are followed by Schools, Museums, Institutes, and Centers", "parameters": [{"name": "search", "in": "query", "type": "string"}, {"name": "ranks", "in": "query", "type": "string"}, {"name": "org_tree", "in": "query", "type": "string"}], "responses": {"200": {"description": "", "schema": {"type": "array", "items": {"$ref": "#/definitions/GetOrgNames"}}}, "401": {"description": "Not authorized"}}, "tags": ["api"]}, "parameters": []}, "/api/get-pds-dept/": {"get": {"operationId": "api_get-pds-dept_list", "description": "Using the EPPN from the request, return the HR department description and prime role indicator\nAdd the Organization by checking against the HrDescMap model", "parameters": [{"name": "eppn", "in": "query", "type": "string"}], "responses": {"200": {"description": "HR department description and prime role indicator", "examples": {"application/json": {"hr_dept_desc": "FAS^SEAS^Computer Science", "prime_role_indicator": true, "organization_slug": "Computer Science (a Harvard Department)"}}}, "400": {"description": "Bad Request"}, "404": {"description": "Not Found"}, "500": {"description": "Internal Server Error"}}, "tags": ["api"]}, "parameters": []}, "/api/get-person-affiliations/": {"get": {"operationId": "api_get-person-affiliations_list", "description": "Return a row for each PersonAffiliation record including the\nPerson's full name and ifxid as well as the ifxorg and the organization slug.\nUsed in org synchronization", "parameters": [{"name": "ifxid", "in": "query", "type": "string"}, {"name": "org_tree", "in": "query", "type": "string"}, {"name": "ifxorg", "in": "query", "type": "string"}], "responses": {"200": {"description": "", "schema": {"type": "array", "items": {"$ref": "#/definitions/GetPersonAffiliations"}}}, "400": {"description": "Bad Request"}, "500": {"description": "Internal Server Error"}}, "tags": ["api"]}, "parameters": []}, "/api/get-pi-names/": {"get": {"operationId": "api_get-pi-names_list", "description": "Return PI first name last name for autocomplete list.  Only active user records returned.", "parameters": [{"name": "search", "in": "query", "type": "string"}], "responses": {"200": {"description": "", "schema": {"type": "array", "items": {"$ref": "#/definitions/GetPiNames"}}}, "401": {"description": "Not authorized"}}, "tags": ["api"]}, "parameters": []}, "/api/get-rc-sisters/": {"get": {"operationId": "api_get-rc-sisters_list", "description": "Return RC organization \"codes\" mapped to Harvard org tree organization ifxorgs.\nUsed in coldfront to make sure \"projects\" are mapped to Harvard orgs", "parameters": [], "responses": {"200": {"description": "", "schema": {"type": "array", "items": {"$ref": "#/definitions/GetRcSisters"}}}, "500": {"description": "Internal Server Error"}}, "tags": ["api"]}, "parameters": []}, "/api/get-user-list/": {"get": {"operationId": "api_get-user-list_list", "description": "Similar to get_basics_by_login, but includes grouped by logins and is_enabled status.\nTakes a generic 'search' term that is tested against username, full_name, lab name,\npi name and department name.  Meant for p3 user listing.", "parameters": [{"name": "search", "in": "query", "type": "string"}, {"name": "org_tree", "in": "query", "type": "string"}, {"name": "include_disabled", "in": "query", "type": "integer"}, {"name": "offset", "in": "query", "type": "integer"}, {"name": "limit", "in": "query", "type": "integer"}, {"name": "order_by", "in": "query", "type": "string"}], "responses": {"200": {"description": "", "schema": {"type": "array", "items": {"$ref": "#/definitions/GetUserList"}}}, "400": {"description": "order_by value not valid"}, "401": {"description": "Not authorized"}}, "tags": ["api"]}, "parameters": []}, "/api/logins/": {"get": {"operationId": "api_logins_list", "description": "Viewset for Logins", "parameters": [{"name": "ordering", "in": "query", "description": "Which field to use when ordering the results.", "required": false, "type": "string"}, {"name": "page", "in": "query", "description": "A page number within the paginated result set.", "required": false, "type": "integer"}, {"name": "page_size", "in": "query", "description": "Number of results to return per page.", "required": false, "type": "integer"}, {"name": "login", "in": "query", "type": "string"}, {"name": "username", "in": "query", "type": "string"}, {"name": "ifxid", "in": "query", "type": "string"}, {"name": "primary_email", "in": "query", "type": "string"}, {"name": "is_enabled", "in": "query", "type": "boolean"}], "responses": {"200": {"description": "", "schema": {"required": ["count", "results"], "type": "object", "properties": {"count": {"type": "integer"}, "next": {"type": "string", "format": "uri", "x-nullable": true}, "previous": {"type": "string", "format": "uri", "x-nullable": true}, "results": {"type": "array", "items": {"$ref": "#/definitions/Login"}}}}}}, "tags": ["api"]}, "post": {"operationId": "api_logins_create", "description": "Viewset for Logins", "parameters": [{"name": "data", "in": "body", "required": true, "schema": {"$ref": "#/definitions/Login"}}], "responses": {"201": {"description": "", "schema": {"$ref": "#/definitions/Login"}}}, "tags": ["api"]}, "parameters": []}, "/api/logins/{id}/": {"get": {"operationId": "api_logins_read", "description": "Viewset for Logins", "parameters": [], "responses": {"200": {"description": "", "schema": {"$ref": "#/definitions/Login"}}}, "tags": ["api"]}, "put": {"operationId": "api_logins_update", "description": "Viewset for Logins", "parameters": [{"name": "data", "in": "body", "required": true, "schema": {"$ref": "#/definitions/Login"}}], "responses": {"200": {"description": "", "schema": {"$ref": "#/definitions/Login"}}}, "tags": ["api"]}, "patch": {"operationId": "api_logins_partial_update", "description": "Viewset for Logins", "parameters": [{"name": "data", "in": "body", "required": true, "schema": {"$ref": "#/definitions/Login"}}], "responses": {"200": {"description": "", "schema": {"$ref": "#/definitions/Login"}}}, "tags": ["api"]}, "delete": {"operationId": "api_logins_delete", "description": "Viewset for Logins", "parameters": [], "responses": {"204": {"description": ""}}, "tags": ["api"]}, "parameters": [{"name": "id", "in": "path", "required": true, "type": "string"}]}, "/api/organizations/": {"get": {